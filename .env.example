# Server-only Neon PostgreSQL pooled connection string. Do not prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Firebase web app configuration used by the existing Firebase Authentication UI.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional transactional report email (Resend). Verify the sender address/domain in Resend first.
# Keep the API key server-only; never use a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=InternShield AI <reports@your-verified-domain.com>
WEB_RISK_API_KEY=your_google_cloud_web_risk_api_key
